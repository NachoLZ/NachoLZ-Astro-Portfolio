---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="100 100 312 312"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  width={Astro.props.size?.width ?? 24}
  height={Astro.props.size?.height ?? 24}
>
  <path
    fill="#533afd"
    fill-rule="evenodd"
    d="m120 392 272-57.683V120l-272 58.357z"
    clip-rule="evenodd"></path>
</svg>
